{
  "name": "nexcrm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --no-warnings --experimental-strip-types --experimental-sqlite src/index.ts",
    "start": "node --no-warnings --experimental-strip-types --experimental-sqlite src/index.ts",
    "seed": "node --no-warnings --experimental-strip-types --experimental-sqlite prisma/seed.ts",
    "setup": "node --no-warnings --experimental-strip-types --experimental-sqlite prisma/seed.ts",
    "test": "node --no-warnings --experimental-strip-types --experimental-sqlite --test src/__tests__/*.test.ts"
  }
}
