# Backend Environment Variables
PORT=4000
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production, change provider in schema.prisma and set:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexcrm?schema=public"
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"
CORS_ORIGIN="http://localhost:5173"

# Gemini Argon AI API Settings (for AI HTML Proposal Generation)
GEMINI_ARGON_API_KEY="your-gemini-argon-api-key-here"
GEMINI_ARGON_MODEL="gemini-2.5-flash"
