generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password_hash String
  role          String          @default("MEMBER") // "ADMIN" | "MEMBER"
  created_at    DateTime        @default(now())

  owned_leads       Lead[]          @relation("LeadOwner")
  lead_notes        LeadNote[]      @relation("LeadNoteAuthor")
  client_notes      ClientNote[]    @relation("ClientNoteAuthor")
  managed_projects  Project[]       @relation("ProjectManager")
  timeline_tasks    TimelineEntry[] @relation("TimelineAssignee")
  recorded_feedback Feedback[]      @relation("FeedbackRecorder")
  assigned_tickets  BauTicket[]     @relation("BauTicketAssignee")
  recorded_payments ClientPayment[] @relation("ClientPaymentAuthor")
  sent_emails       EmailLog[]      @relation("EmailLogSender")
}

model Lead {
  id            String      @id @default(uuid())
  name          String
  company       String
  email         String
  phone         String
  source        String      // Website, Referral, LinkedIn, Cold outreach, Event, Other
  service       String      // Web development, Mobile app, Custom software, Cloud/DevOps, UI/UX, IT consulting, Maintenance/support, Other
  budget        Float       @default(0)
  currency      String      @default("USD")
  status        String      @default("New") // New, Contacted, Meeting scheduled, Proposal sent, Negotiation
  owner_id      String?
  next_followup     DateTime?
  followup_resource String      @default("")
  notes             String      @default("")
  created_at    DateTime    @default(now())

  owner         User?       @relation("LeadOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  lead_notes    LeadNote[]
  conversion    Conversion?
  client        Client?
  email_logs    EmailLog[]
}

model LeadNote {
  id         String   @id @default(uuid())
  lead_id    String
  text       String
  created_by String?
  created_at DateTime @default(now())

  lead       Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  author     User?    @relation("LeadNoteAuthor", fields: [created_by], references: [id], onDelete: SetNull)
}

model Conversion {
  id         String    @id @default(uuid())
  lead_id    String    @unique
  outcome    String    @default("in_progress") // in_progress | converted | not_converted
  reason     String?   // Budget, Went to competitor, No response, Timing, Requirements mismatch, Other
  comment    String?
  deal_value Float?
  currency   String    @default("USD")
  decided_at DateTime?
  history    String    @default("[]") // JSON array recording outcome changes over time
  created_at DateTime  @default(now())

  lead       Lead      @relation(fields: [lead_id], references: [id], onDelete: Cascade)
}

model Client {
  id               String       @id @default(uuid())
  lead_id          String?      @unique
  company          String
  contact_name     String
  email            String
  phone            String
  address          String       @default("")
  website          String       @default("")
  industry         String       @default("")
  status           String       @default("Active") // Active, On hold, Completed, Inactive
  notes            String       @default("")
  became_client_at DateTime     @default(now())
  created_at       DateTime     @default(now())

  lead             Lead?        @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  projects         Project[]
  client_notes     ClientNote[]
  feedbacks        Feedback[]
  bau_tickets      BauTicket[]
  payments         ClientPayment[]
}

model ClientNote {
  id         String   @id @default(uuid())
  client_id  String
  text       String
  created_by String?
  created_at DateTime @default(now())

  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  author     User?    @relation("ClientNoteAuthor", fields: [created_by], references: [id], onDelete: SetNull)
}

model Project {
  id                String          @id @default(uuid())
  client_id         String
  name              String
  description       String          @default("")
  service_type      String          // Web development, Mobile app, Custom software, Cloud/DevOps, UI/UX, IT consulting, Maintenance/support, Other
  status            String          @default("Planned") // Planned, In progress, On hold, Completed, Cancelled
  start_date        DateTime
  end_date          DateTime
  budget            Float           @default(0)
  currency          String          @default("USD")
  manager_id        String?
  tech_stack        String          @default("") // Comma-separated tags
  progress          Int             @default(0)  // 0-100
  progress_override Boolean         @default(false)
  notes             String          @default("")
  amc_active        Boolean         @default(false)
  amc_status        String          @default("Not Contracted") // Not Contracted, Active, Pending Renewal, Expired
  amc_amount        Float           @default(0)
  amc_start_date    DateTime?
  amc_end_date      DateTime?
  amc_billing_cycle String          @default("Annual") // Annual, Semi-Annual, Quarterly, Monthly
  amc_sla_tier      String          @default("Standard 9x5") // Standard 9x5, 24/7 Mission Critical, Basic Support
  amc_scope         String          @default("")
  amc_contact       String          @default("")
  created_at        DateTime        @default(now())

  client            Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  manager           User?           @relation("ProjectManager", fields: [manager_id], references: [id], onDelete: SetNull)
  timeline_entries  TimelineEntry[]
  feedbacks         Feedback[]
  bau_tickets       BauTicket[]
  resource_assignments ResourceAssignment[]
  payments          ClientPayment[]
}

model TimelineEntry {
  id          String    @id @default(uuid())
  project_id  String
  title       String
  description String    @default("")
  type        String    @default("Task") // Milestone, Task, Meeting, Delivery, Issue, Note
  start_date  DateTime
  end_date    DateTime?
  status      String    @default("Planned") // Planned, In progress, Done, Delayed
  assignee_id String?
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())

  project     Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TimelineAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
}

model Feedback {
  id             String   @id @default(uuid())
  client_id      String
  project_id     String?
  rating         Int      @default(5) // 1 to 5
  sentiment      String   @default("Positive") // Positive, Neutral, Constructive, Critical
  category       String   @default("Delivery Quality") // Delivery Quality, Communication, Timeline & Speed, Technical Expertise, Support & SLA, General
  comment        String
  action_taken   String   @default("")
  status         String   @default("Reviewed") // New, Reviewed, Action in progress, Resolved
  submitted_by   String   @default("")
  feedback_date  DateTime @default(now())
  recorded_by    String?
  is_testimonial Boolean  @default(false)
  created_at     DateTime @default(now())

  client         Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  project        Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  recorder       User?    @relation("FeedbackRecorder", fields: [recorded_by], references: [id], onDelete: SetNull)
}

model BauTicket {
  id               String    @id @default(uuid())
  ticket_number    String    @unique
  client_id        String
  project_id       String
  title            String
  description      String    @default("")
  category         String    @default("Bug / Defect") // Bug / Defect, Change Request, Performance, Access & Security, Environment / Infra, Data / Reporting
  priority         String    @default("Medium") // Low, Medium, High, Critical
  state            String    @default("New") // New | Work in progress | Pending | Resolved
  reported_by      String    @default("")
  assignee_id      String?
  resolution_notes String    @default("")
  sla_due_date     DateTime?
  resolved_at      DateTime?
  created_at       DateTime  @default(now())

  client           Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  project          Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee         User?     @relation("BauTicketAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
}

model Resource {
  id             String               @id @default(uuid())
  name           String
  email          String               @unique
  role_title     String               // e.g. Senior Full-Stack Engineer, Cloud Architect
  department     String               @default("Engineering") // Engineering, Cloud & DevOps, AI & Data, Design & UX, Delivery & QA
  seniority      String               @default("Senior") // Principal, Senior, Mid-Level, Junior
  skills         String               @default("") // Comma-separated skills
  total_capacity Int                  @default(100) // Weekly capacity % (usually 100)
  hourly_rate    Float                @default(85)
  on_leave       Boolean              @default(false)
  notes          String               @default("")
  created_at     DateTime             @default(now())

  assignments    ResourceAssignment[]
}

model ResourceAssignment {
  id              String   @id @default(uuid())
  resource_id     String
  project_id      String
  assignment_role String   @default("Software Engineer")
  allocation_pct  Int      @default(50) // 5 to 100
  start_date      DateTime
  end_date        DateTime
  status          String   @default("Active") // Active, Planned, Completed
  notes           String   @default("")
  created_at      DateTime @default(now())

  resource        Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model Proposal {
  id               String    @id @default(uuid())
  proposal_number  String    @unique
  lead_id          String?
  client_id        String?
  company_name     String
  recipient_name   String
  recipient_email  String
  project_title    String
  service_type     String    @default("Custom software")
  budget           Float     @default(0)
  currency         String    @default("USD")
  timeline_weeks   Int       @default(8)
  key_requirements String    @default("")
  email_subject    String
  email_body       String
  html_proposal    String
  ai_model         String    @default("Gemini Argon AI")
  status           String    @default("Draft") // Draft, Sent, Accepted, Declined
  sent_at          DateTime?
  created_by       String?
  created_at       DateTime  @default(now())
}

model ClientPayment {
  id              String    @id @default(uuid())
  client_id       String
  project_id      String
  phase_name      String
  phase_number    Int       @default(1)
  amount          Float     @default(0)
  currency        String    @default("INR")
  percentage      Float     @default(0)
  status          String    @default("Pending") // Pending, Invoiced, Partially Paid, Paid, Overdue
  due_date        DateTime
  paid_date       DateTime?
  paid_amount     Float     @default(0)
  invoice_number  String    @default("")
  payment_method  String    @default("Bank Transfer / NEFT")
  transaction_ref String    @default("")
  notes           String    @default("")
  created_by      String?
  created_at      DateTime  @default(now())

  client          Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  author          User?     @relation("ClientPaymentAuthor", fields: [created_by], references: [id], onDelete: SetNull)
}

model EmailLog {
  id              String   @id @default(uuid())
  lead_id         String?
  client_id       String?
  recipient_email String
  recipient_name  String
  subject         String
  body            String
  status          String   @default("Sent") // Sent | Simulated | Failed
  provider        String   @default("CRM Mailer")
  error_message   String   @default("")
  sent_by         String?
  sent_at         DateTime @default(now())

  lead            Lead?    @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  sender          User?    @relation("EmailLogSender", fields: [sent_by], references: [id], onDelete: SetNull)
}

model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}



